{
  "name": "aiu-containers-electron",
  "version": "0.1.0",
  "description": "List running Apple containers and build images from a Dockerfile",
  "main": "./out/main/index.js",
  "author": "Ion Utale",
  "homepage": "https://electron-vite.org",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:tests && pnpm svelte-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:real": "pnpm build && AIU_E2E_REAL_CLI=1 playwright test e2e/real-cli.e2e.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && node scripts/ensure-electron-dist.mjs",
    "doctor": "node scripts/ensure-electron-dist.mjs",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:mac": "pnpm build && electron-builder --mac"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.19.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
